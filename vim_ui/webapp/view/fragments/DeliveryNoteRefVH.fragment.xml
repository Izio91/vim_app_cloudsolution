<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core">
	<TableSelectDialog 
		id="idDeliveryNoteRefDialog_VH" 
        resizable="true"
		noDataText="{i18n>NoDeliveryNoteRefFound}"
		items="{path: 'detailDetailModel>/valuehelps/deliveryNoteReferements'}"
		title="{i18n>TitleSearchDeliveryNoteReferements}"
		search="onSearchDeliveryNoteReferements"
		confirm="onConfirmDeliveryNoteReferement">
        <ColumnListItem vAlign="Middle">
            <cells>
                <ObjectIdentifier
                    title="{detailDetailModel>ReferenceDocument}"/>
                <Text
                    text="{detailDetailModel>MaterialDocument}" />
                <Text
                    text="{detailDetailModel>MaterialDocumentItem}" />
                <Text
                    text="{detailDetailModel>Material}" />
                <Text
                    text="{detailDetailModel>ProductName}" />
                <Text
                    text="{detailDetailModel>Plant}" />
                <Text
                    text="{detailDetailModel>PostingDate}" />
                <Text
                    text="{detailDetailModel>DocumentDate}" />
                <Text
                    text="{detailDetailModel>CreationDate}" />
                <Text
                    text="{detailDetailModel>CreatedByUser}" />
                <Text
                    text="{detailDetailModel>Quantity}" />
                <Text
                    text="{detailDetailModel>PurchaseOrderQuantityUnit}" />
                
            </cells>
        </ColumnListItem>
		<columns>
			<Column width="12em">
				<header>
					<Text text="{i18n>ReferenceDocument}" />
				</header>
			</Column>
			<Column
				minScreenWidth="Tablet"
				demandPopin="true"
				hAlign="End">
				<header>
					<Text text="{i18n>MaterialDocument}" />
				</header>
			</Column>
			<Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Center">
				<header>
					<Text text="{i18n>MaterialDocumentItem}" />
				</header>
			</Column>
			<Column hAlign="End">
				<header>
					<Text text="{i18n>Material}" />
				</header>
			</Column>
			<Column hAlign="End">
				<header>
					<Text text="{i18n>ProductName}" />
				</header>
			</Column>
			<Column hAlign="End">
				<header>
					<Text text="{i18n>Plant}" />
				</header>
			</Column>
			<Column hAlign="End">
				<header>
					<Text text="{i18n>PostingDate}" />
				</header>
			</Column>
			<Column hAlign="End">
				<header>
					<Text text="{i18n>DocumentDate}" />
				</header>
			</Column>
			<Column hAlign="End">
				<header>
					<Text text="{i18n>CreationDate}" />
				</header>
			</Column>
			<Column hAlign="End">
				<header>
					<Text text="{i18n>CreatedByUser}" />
				</header>
			</Column>
			<Column hAlign="End">
				<header>
					<Text text="{i18n>Quantity}" />
				</header>
			</Column>
			<Column hAlign="End">
				<header>
					<Text text="{i18n>PurchaseOrderQuantityUnit}" />
				</header>
			</Column>
		</columns>
	</TableSelectDialog>
</core:FragmentDefinition>